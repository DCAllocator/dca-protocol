{
  "name": "dca-protocol",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter @dca/web dev",
    "dev:test-vault": "pnpm --filter @dca/web dev:test-vault",
    "dev:latency": "pnpm --filter @dca/web dev:latency",
    "latency": "node scripts/rpc-latency.mjs",
    "abi:check": "node scripts/abi-check.mjs",
    "scheduler": "pnpm --filter @dca/scheduler dev",
    "balance": "pnpm --filter @dca/scheduler balance",
    "transfer": "pnpm --filter @dca/scheduler transfer",
    "fork": "bash scripts/fork.sh",
    "share": "bash scripts/share.sh",
    "fund": "bash scripts/fund-tester.sh",
    "protocol:deploy": "bash scripts/deploy.sh"
  },
  "packageManager": "pnpm@10.33.0"
}
