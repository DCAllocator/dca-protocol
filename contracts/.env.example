# ---- RPC ----
RH_RPC=https://rpc.robinhood.xyz            # TODO verify official Robinhood Chain (4663) RPC
PRIVATE_KEY=                                 # deployer key (or use --ledger / --account)

# ---- Protocol admin ----
OWNER=0x0000000000000000000000000000000000000000          # multisig; accepts ownership post-deploy
FEE_RECIPIENT=0x0000000000000000000000000000000000000000  # treasury / buyback wallet
KEEPERS=                                                  # comma-separated bot EOAs: vault keepers + EpochKeeper operators (add the Chainlink forwarder too)

# ---- Tokens (see config/addresses.rh.json) ----
USDG=0x0000000000000000000000000000000000000000
WETH=0x0000000000000000000000000000000000000000
DCA=0x0000000000000000000000000000000000000000            # leave empty to disable perks (ALLOW_NO_DCA=true on 4663)
ALLOW_NO_DCA=false

# ---- Boost (optional): Morpho Blue singleton + the id of a market whose loan token is USDG. Empty = no boost. ----
MORPHO=
MORPHO_MARKET_ID=
BOOST_SEED_USDG=100                          # whole USDG the deployer seeds into the strategy as dead shares (0 = skip; see AUDIT.md M-01)

# ---- Page sizing: a page never buys more than this, so `limit` is a max plan count and pages fit the pools ----
MAX_PAGE_NOTIONAL_USDG=100000                # vault-wide default (whole USDG; 0 = unlimited)
PAGE_NOTIONAL_CAPS=                          # 0xstock:wholeUsdg,... per-stock overrides; size with `forge script script/RouteBench.s.sol`

# ---- Price guard (audit v0.3 H-01): Chainlink AggregatorV3 feeds, USD per raw Stock Token ----
PRICE_FEEDS=                                 # 0xstock:0xfeed,... set on every vault. Required for every approved stock unless REQUIRE_PRICE_FEED=false
FEED_MAX_STALENESS=90000                     # seconds since the feed's updatedAt after which a buy is refused (25 h covers a 24 h heartbeat)
PRICE_GUARD_BPS=300                          # a page's minOut must be >= reference x (1 - this); 300 = 3%
REQUIRE_PRICE_FEED=true                      # false = stocks without a feed are bought unguarded (NOT recommended on 4663)
SEQUENCER_FEED=                              # Chainlink L2 sequencer uptime feed, if published on Robinhood Chain (empty = not checked)
SEQUENCER_GRACE=3600                         # seconds the sequencer must be up before feeds are trusted again

# ---- DEX (address(0) / empty disables that adapter) ----
UNIV3_FACTORY=
UNIV4_POOL_MANAGER=
RAMSES_FACTORY=

# ---- Stocks to list at deploy: SYMBOL:address,... (can also be listed later via StockRegistry) ----
STOCKS=NVDA:0x0000000000000000000000000000000000000000,AAPL:0x0000000000000000000000000000000000000000

# ---- Approved routes (optional at deploy): protocol:pool, both directions approved. 1 = Uniswap V3, 3 = Ramses V3.
# V4 keys: script/ApproveRoutes.s.sol after UniV4Adapter.addPool.
V3_POOLS=
