# ---- RPC ----
RH_RPC=https://rpc.robinhood.xyz            # TODO verify official Robinhood Chain (4663) RPC
PRIVATE_KEY=                                 # deployer key (or use --ledger / --account)

# ---- Protocol admin ----
OWNER=0x0000000000000000000000000000000000000000          # multisig; accepts ownership post-deploy
FEE_RECIPIENT=0x0000000000000000000000000000000000000000  # treasury / buyback wallet
KEEPERS=                                                  # comma-separated bot EOAs: vault keepers + EpochKeeper operators (add the Chainlink forwarder too)

# ---- Tokens (see config/addresses.rh.json) ----
USDG=0x0000000000000000000000000000000000000000
WETH=0x0000000000000000000000000000000000000000
DCA=0x0000000000000000000000000000000000000000            # leave empty to disable perks (ALLOW_NO_DCA=true on 4663)
ALLOW_NO_DCA=false

# ---- Boost (optional): Morpho Blue singleton + the id of a market whose loan token is USDG. Empty = no boost. ----
MORPHO=
MORPHO_MARKET_ID=

# ---- DEX (address(0) / empty disables that adapter) ----
UNIV3_FACTORY=
UNIV4_POOL_MANAGER=
RAMSES_FACTORY=

# ---- Stocks to list at deploy: SYMBOL:address,... (can also be listed later via StockRegistry) ----
STOCKS=NVDA:0x0000000000000000000000000000000000000000,AAPL:0x0000000000000000000000000000000000000000

# ---- Approved routes (optional at deploy): protocol:pool, both directions approved. 1 = Uniswap V3, 3 = Ramses V3.
# V4 keys: script/ApproveRoutes.s.sol after UniV4Adapter.addPool.
V3_POOLS=
