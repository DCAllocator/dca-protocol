# JSON-RPC endpoint. `pnpm fork` writes apps/scheduler/.env.local pointing at the local anvil.
RPC_URL=http://127.0.0.1:8545

# Bot wallet. Only pays gas for EpochKeeper.run(); receives USDG keeper tips if a vault enables them.
# Never put a funded production key in a committed file — use the process environment or a secret store.
PRIVATE_KEY=

# EpochKeeper address. Optional: falls back to ../../contracts/deployments/<chainId>.json ("keeper").
KEEPER_ADDRESS=

# Longest time between two due-checks (the bot also wakes right after each vault boundary). Default 30.
POLL_INTERVAL_SECONDS=30
# Wake this long after a boundary so the boundary block has landed. Default 3.
BOUNDARY_GRACE_SECONDS=3
# Max EpochKeeper.run pages per job per tick (150 plans/page by default on the vault). Default 20.
MAX_PAGES_PER_JOB=20
# `limit` passed to run(); 0 = vault.maxPlansPerTx. Default 0.
PAGE_LIMIT=0
# Give up waiting for a receipt after this long. Default 120.
TX_TIMEOUT_SECONDS=120
# How often to look for plans on a stock the keeper has no active job for (they are never bought; each one is logged
# as a warning). 0 turns the check off. Default 300.
UNCOVERED_CHECK_SECONDS=300

# DRY_RUN=1 simulates and logs but never sends. ONCE=1 runs a single tick (same as --once).
# DEBUG=1 prints per-tick sleep/boundary lines.
